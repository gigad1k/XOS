  "generic_display": {
    "note": "What a display device gets when its vendor has no row. This is not a guess about the card, which the HW-2 guardrail forbids: it is the generic userspace over whatever in-tree driver the kernel already bound, then the generic modesetting X driver, then a plain framebuffer. One of those three puts a picture on any screen that can show one. A vendor gets its own row only when there is something specific worth saying.",
    "driver": "mesa",
    "firmware": [
      "linux-firmware"
    ],
    "fallback": [
