# Where the installer fetches packages from.
#
# The pacman-mirrorlist package ships every server commented out, so a medium
# that relies on it has no mirror at all and pacstrap stops with "no servers
# configured". Arch's own geo-routing mirror is one line and resolves to
# something near whoever is installing, which is the right default for a
# medium that will be booted in places nobody can predict.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch

# Two more, in case the first is having a bad day mid-install.
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://america.mirror.pkgbuild.com/$repo/os/$arch
